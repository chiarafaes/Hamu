      "owner_skill": "hamu-security-privacy",
      "title": "Google Analytics loads before consent",
      "status": "fail",
      "severity": "high",
      "confidence": "high",
      "method": "automated",
      "legal_review": false,
      "summary_plain": "Visitors are tracked by Google Analytics before they accept cookies. In Belgium this breaks the cookie rules and is a common reason for complaints to the data protection authority.",
      "detail_technical": "On first load with no consent state, a request to region1.google-analytics.com/g/collect fires and _ga cookies are set before any banner interaction.",
      "impact": [
        "legal",
        "privacy"
      ],
      "frameworks": [
        {
          "id": "EPRIVACY-BE",
          "ref": "Art. 10/2 Law of 30 July 2018",
          "relation": "requirement"
        },
        {
          "id": "GDPR",
          "ref": "Art. 6, Art. 7",
          "relation": "requirement"
        }
      ],
      "evidence": [
        {
          "type": "network_request",
          "location": "https://shop.example.be/ (before consent)",
          "snippet": "POST https://region1.google-analytics.com/g/collect?v=2&tid=G-XXXX ...",
          "captured_at": "2026-11-19T17:40:02+01:00"
        },
        {
          "type": "cookie",
          "location": "https://shop.example.be/ (before consent)",
          "snippet": "_ga, _ga_XXXX set on .example.be"
        }
      ],
      "fix": {
        "summary": "Block analytics until opt-in.",
        "steps": [
          "Load gtag only after consent, or use Consent Mode v2 with default 'denied' for analytics_storage and ad_storage.",
          "Re-test with a clean browser profile."

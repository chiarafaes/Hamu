      "owner_skill": "hamu-security-privacy",
      "title": "HSTS header missing",
      "status": "fail",
      "severity": "medium",
      "confidence": "high",
      "method": "automated",
      "summary_plain": "The site does not tell browsers to always use a secure connection, so visitors can be pushed to an unencrypted version by an attacker on the same network.",
      "detail_technical": "Response for https://shop.example.be/ has no Strict-Transport-Security header.",
      "impact": [
        "security"
      ],
      "frameworks": [
        {
          "id": "ASVS5",
          "ref": "V3.4.1",
          "relation": "requirement"
        },
        {
          "id": "ISO27001",
          "ref": "A.8.24",
          "relation": "evidence_for"
        },
        {
          "id": "GDPR",
          "ref": "Art. 32",
          "relation": "evidence_for"
        }
      ],
      "evidence": [
        {
          "type": "http_header",
          "location": "https://shop.example.be/",
          "snippet": "HTTP/2 200; no strict-transport-security header present",
          "captured_at": "2026-11-19T17:36:10+01:00"
        }
      ],
      "fix": {
        "summary": "Send HSTS on all HTTPS responses.",
        "steps": [
          "Add the header at the CDN or web server.",
          "Start with a short max-age, raise to 1 year after checking all subdomains use HTTPS."
        ],
        "code_example": "Strict-Transport-Security: max-age=31536000; includeSubDomains",
        "effort": "S"
      },
      "applies_because": [
        "target.urls"
      ]
    },
